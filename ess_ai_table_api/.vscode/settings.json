{
    "python.defaultInterpreterPath": "C:\\Users\\user\\anaconda3\\python.exe",
    "python.pythonPath": "C:\\Users\\user\\anaconda3\\python.exe",
    "python.condaPath": "C:\\Users\\user\\anaconda3\\Scripts\\conda.exe",
    "python.venvPath": "C:\\Users\\user\\anaconda3\\envs",
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
    "python.terminal.activateEnvironment": true,
    "jupyter.notebookFileRoot": "${workspaceFolder}",
    "jupyter.jupyterServerType": "local",
    "jupyter.defaultKernel": "base",
    "jupyter.kernels.filter": [],
